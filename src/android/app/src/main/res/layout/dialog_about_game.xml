<?xml version="1.0" encoding="utf-8"?>
<!-- Game page (Twin Screen redesign). Opens full height from a long-press on a game. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <com.google.android.material.bottomsheet.BottomSheetDragHandleView
        android:id="@+id/drag_handle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content" />

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:fadeScrollbars="false"
        android:fadingEdgeLength="32dp"
        android:requiresFadingEdge="vertical"
        android:scrollbarDefaultDelayBeforeFade="0"
        android:scrollbarFadeDuration="0"
        android:scrollbarSize="4dp"
        android:scrollbarStyle="outsideOverlay"
        android:scrollbarThumbVertical="@drawable/scrollbar_thumb"
        android:scrollbars="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="18dp"
            android:paddingBottom="28dp">

            <!-- ============ Hero ============ -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <com.google.android.material.imageview.ShapeableImageView
                    android:id="@+id/game_icon"
                    android:layout_width="104dp"
                    android:layout_height="104dp"
                    android:focusable="false"
                    android:importantForAccessibility="no"
                    android:padding="1dp"
                    app:shapeAppearance="@style/ShapeAppearance.Citra.Corner.Small"
                    app:strokeColor="?attr/citraStrokeColor"
                    app:strokeWidth="2dp" />

                <LinearLayout
                    android:id="@+id/constraintLayout"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="16dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/about_game_title"
                        style="@style/TextAppearance.Citra.TitleMedium"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:maxLines="3"
                        android:ellipsize="end"
                        android:textAlignment="viewStart"
                        android:textColor="?attr/colorOnSurface"
                        android:textSize="20sp"
                        tools:text="Application Title" />

                    <TextView
                        android:id="@+id/about_game_company"
                        style="@style/TextAppearance.Citra.Meta"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:textAlignment="viewStart"
                        tools:text="Company" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/about_game_region"
                            style="@style/TextAppearance.Citra.Meta"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginEnd="6dp"
                            android:background="@drawable/bg_citra_tag"
                            android:maxWidth="140dp"
                            android:paddingHorizontal="6dp"
                            android:paddingVertical="2dp"
                            android:singleLine="true"
                            android:ellipsize="end"
                            android:textColor="?attr/colorOnSurface"
                            android:textStyle="bold"
                            tools:text="USA" />

                        <TextView
                            android:id="@+id/about_game_filetype"
                            style="@style/TextAppearance.Citra.Meta"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:background="@drawable/bg_citra_tag"
                            android:paddingHorizontal="6dp"
                            android:paddingVertical="2dp"
                            android:singleLine="true"
                            android:textColor="?attr/colorOnSurface"
                            android:textStyle="bold"
                            tools:text="CCI" />

                    </LinearLayout>

                </LinearLayout>

            </LinearLayout>

            <!-- ============ Primary actions ============ -->
            <LinearLayout
                android:id="@+id/horizontal_layout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/about_game_play"
                    style="@style/Widget.Citra.Button.Icon"
                    android:layout_width="0dp"
                    android:layout_height="56dp"
                    android:layout_weight="1"
                    android:contentDescription="@string/play"
                    android:focusedByDefault="true"
                    android:text="@string/play"
                    android:textAlignment="center"
                    app:icon="@drawable/ic_play"
                    app:iconGravity="textStart" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/menu_button_open"
                    style="@style/Widget.Citra.IconButton.FilledTonal"
                    android:layout_width="52dp"
                    android:layout_height="56dp"
                    android:layout_marginStart="8dp"
                    android:contentDescription="@string/game_context_open_app"
                    app:icon="@drawable/ic_open"
                    app:iconGravity="textStart" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/menu_button_uninstall"
                    style="@style/Widget.Citra.IconButton.FilledTonal"
                    android:layout_width="52dp"
                    android:layout_height="56dp"
                    android:layout_marginStart="8dp"
                    android:contentDescription="@string/uninstall_cia"
                    app:icon="@drawable/ic_uninstall"
                    app:iconGravity="textStart" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/game_shortcut"
                    style="@style/Widget.Citra.IconButton.FilledTonal"
                    android:layout_width="52dp"
                    android:layout_height="56dp"
                    android:layout_marginStart="8dp"
                    android:contentDescription="@string/shortcut"
                    app:icon="@drawable/ic_shortcut"
                    app:iconGravity="textStart" />

            </LinearLayout>

            <!-- ============ Stats ============ -->
            <TextView
                style="@style/TextAppearance.Citra.SectionHeader"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="28dp"
                android:layout_marginBottom="10dp"
                android:text="@string/game_page_stats"
                android:textColor="?attr/colorPrimary" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_citra_panel_shadow"
                android:orientation="vertical"
                android:paddingStart="16dp"
                android:paddingTop="14dp"
                android:paddingEnd="19dp"
                android:paddingBottom="17dp">

                <TextView
                    android:id="@+id/about_game_playtime_label"
                    style="@style/TextAppearance.Citra.Meta"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    tools:text="Playtime" />

                <TextView
                    android:id="@+id/about_game_playtime"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:fontFamily="monospace"
                    android:textColor="?attr/colorOnSurface"
                    android:textSize="28sp"
                    android:textStyle="bold"
                    tools:text="12h 34m 56s" />

            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:baselineAligned="false"
                android:orientation="horizontal">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_marginEnd="6dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_citra_panel_shadow"
                    android:orientation="vertical"
                    android:paddingStart="14dp"
                    android:paddingTop="12dp"
                    android:paddingEnd="17dp"
                    android:paddingBottom="15dp">

                    <TextView
                        style="@style/TextAppearance.Citra.Meta"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/game_page_last_played" />

                    <TextView
                        android:id="@+id/about_game_last_played"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:fontFamily="monospace"
                        android:textColor="?attr/colorOnSurface"
                        android:textSize="15sp"
                        android:textStyle="bold"
                        tools:text="3 days ago" />

                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_marginStart="6dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_citra_panel_shadow"
                    android:orientation="vertical"
                    android:paddingStart="14dp"
                    android:paddingTop="12dp"
                    android:paddingEnd="17dp"
                    android:paddingBottom="15dp">

                    <TextView
                        style="@style/TextAppearance.Citra.Meta"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/game_page_added" />

                    <TextView
                        android:id="@+id/about_game_added"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:fontFamily="monospace"
                        android:textColor="?attr/colorOnSurface"
                        android:textSize="15sp"
                        android:textStyle="bold"
                        tools:text="Nov 2, 2026" />

                </LinearLayout>

            </LinearLayout>

            <!-- ============ Details ============ -->
            <TextView
                style="@style/TextAppearance.Citra.SectionHeader"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="28dp"
                android:layout_marginBottom="10dp"
                android:text="@string/game_page_details"
                android:textColor="?attr/colorPrimary" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_citra_panel_shadow"
                android:orientation="vertical"
                android:paddingStart="2dp"
                android:paddingTop="2dp"
                android:paddingEnd="5dp"
                android:paddingBottom="5dp">

                <!-- Title ID -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:padding="12dp">

                    <TextView
                        android:id="@+id/about_game_id_label"
                        style="@style/TextAppearance.Citra.Meta"
                        android:layout_width="104dp"
                        android:layout_height="wrap_content"
                        tools:text="ID" />

                    <TextView
                        android:id="@+id/about_game_id"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:fontFamily="monospace"
                        android:textColor="?attr/colorOnSurface"
                        android:textIsSelectable="true"
                        android:textSize="14sp"
                        tools:text="0004000000033500" />

                </LinearLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="2dp"
                    android:background="?attr/citraStrokeColor" />

                <!-- File -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:padding="12dp">

                    <TextView
                        android:id="@+id/about_game_filename_label"
                        style="@style/TextAppearance.Citra.Meta"
                        android:layout_width="104dp"
                        android:layout_height="wrap_content"
                        tools:text="File" />

                    <TextView
                        android:id="@+id/about_game_filename"
                        style="@style/TextAppearance.Material3.BodyMedium"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:textColor="?attr/colorOnSurface"
                        android:textIsSelectable="true"
                        tools:text="game.cci" />

                </LinearLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="2dp"
                    android:background="?attr/citraStrokeColor" />

                <!-- Storage -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:padding="12dp">

                    <TextView
                        style="@style/TextAppearance.Citra.Meta"
                        android:layout_width="104dp"
                        android:layout_height="wrap_content"
                        android:text="@string/game_page_storage" />

                    <TextView
                        android:id="@+id/about_game_storage"
                        style="@style/TextAppearance.Material3.BodyMedium"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:textColor="?attr/colorOnSurface"
                        tools:text="Game file" />

                </LinearLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="2dp"
                    android:background="?attr/citraStrokeColor" />

                <!-- Compressed -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:padding="12dp">

                    <TextView
                        style="@style/TextAppearance.Citra.Meta"
                        android:layout_width="104dp"
                        android:layout_height="wrap_content"
                        android:text="@string/game_page_compressed" />

                    <TextView
                        android:id="@+id/about_game_compressed"
                        style="@style/TextAppearance.Material3.BodyMedium"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:textColor="?attr/colorOnSurface"
                        tools:text="No" />

                </LinearLayout>

            </LinearLayout>

            <!-- ============ Manage ============ -->
            <TextView
                style="@style/TextAppearance.Citra.SectionHeader"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="28dp"
                android:layout_marginBottom="10dp"
                android:text="@string/game_page_manage"
                android:textColor="?attr/colorPrimary" />

            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:nextFocusRight="@id/about_game_play">

                <androidx.constraintlayout.helper.widget.Flow
                    android:id="@+id/horizontal_flow_2"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    app:constraint_referenced_ids="application_settings,cheats,insert_cartridge_button,compress_decompress,delete_cache"
                    app:flow_horizontalAlign="start"
                    app:flow_horizontalBias="0"
                    app:flow_horizontalGap="8dp"
                    app:flow_horizontalStyle="packed"
                    app:flow_verticalGap="8dp"
                    app:flow_wrapMode="chain"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/application_settings"
                    style="@style/Widget.Citra.Button.Tonal.Icon"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:contentDescription="@string/application_settings"
                    android:text="@string/application_settings"
                    app:icon="@drawable/ic_settings" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/cheats"
                    style="@style/Widget.Citra.Button.Tonal.Icon"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:contentDescription="@string/cheats"
                    android:text="@string/cheats"
                    app:icon="@drawable/ic_code" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/insert_cartridge_button"
                    style="@style/Widget.Citra.Button.Tonal.Icon"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/compress_decompress"
                    style="@style/Widget.Citra.Button.Tonal.Icon"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:contentDescription="@string/compress"
                    android:text="@string/compress" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/delete_cache"
                    style="@style/Widget.Citra.Button.Tonal.Icon"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:contentDescription="@string/delete_shader_cache"
                    android:text="@string/delete_shader_cache" />

            </androidx.constraintlayout.widget.ConstraintLayout>

        </LinearLayout>

    </androidx.core.widget.NestedScrollView>

</LinearLayout>
