<?xml version="1.0" encoding="utf-8"?>
<!-- Nebula: one tile in the home screen's recently played row -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/tile_root"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:layout_marginEnd="4dp"
    android:background="?attr/selectableItemBackgroundBorderless"
    android:clickable="true"
    android:focusable="true"
    android:gravity="center_vertical"
    android:orientation="horizontal">

    <!-- Holds the white ring when the tile is selected -->
    <FrameLayout
        android:id="@+id/tile_frame"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:padding="5dp">

        <com.google.android.material.imageview.ShapeableImageView
            android:id="@+id/tile_icon"
            android:layout_width="@dimen/nebula_tile"
            android:layout_height="@dimen/nebula_tile"
            android:importantForAccessibility="no"
            android:scaleType="centerCrop"
            app:shapeAppearance="@style/ShapeAppearance.Nebula.Corner.Medium" />

    </FrameLayout>

    <TextView
        android:id="@+id/tile_title"
        style="@style/TextAppearance.Nebula.TitleSmall"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="10dp"
        android:layout_marginEnd="8dp"
        android:maxWidth="220dp"
        android:singleLine="true"
        android:ellipsize="end"
        android:textColor="?attr/colorOnSurface"
        android:textSize="15sp"
        android:visibility="gone"
        tools:text="Sky Harbor"
        tools:visibility="visible" />

</LinearLayout>
