<?xml version="1.0" encoding="utf-8"?>
<!-- Nebula Options screen: large light title and one rounded glass list -->
<androidx.core.widget.NestedScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/scroll_view_settings"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/colorSurface"
    android:scrollbars="none"
    android:clipToPadding="false">

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <!-- Soft glow behind the title -->
        <View
            android:layout_width="420dp"
            android:layout_height="320dp"
            android:layout_marginStart="-80dp"
            android:layout_marginTop="-140dp"
            android:background="@drawable/bg_nebula_glow" />

        <androidx.appcompat.widget.LinearLayoutCompat
            android:id="@+id/linear_layout_settings"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingTop="12dp">

            <!-- Kept for the code that references it; the Nebula header shows text instead -->
            <ImageView
                android:id="@+id/logo_image"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_citra_full"
                android:visibility="gone" />

            <TextView
                style="@style/TextAppearance.Nebula.HeadlineLarge"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="20dp"
                android:text="@string/home_options"
                android:textColor="?attr/colorOnSurface" />

            <TextView
                android:id="@+id/options_version"
                style="@style/TextAppearance.Nebula.Body"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="20dp"
                android:layout_marginTop="6dp"
                android:textColor="?attr/colorOnSurfaceVariant"
                android:textSize="13sp"
                tools:text="Azahar · 2125.0" />

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/home_settings_list"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="20dp"
                android:layout_marginTop="24dp"
                android:background="@drawable/bg_nebula_glass_group"
                android:clipToOutline="true"
                android:nestedScrollingEnabled="false"
                android:overScrollMode="never" />

        </androidx.appcompat.widget.LinearLayoutCompat>

    </FrameLayout>

</androidx.core.widget.NestedScrollView>
