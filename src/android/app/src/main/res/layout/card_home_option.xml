<?xml version="1.0" encoding="utf-8"?>
<!-- Nebula: one row in the Options glass list -->
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    style="@style/Widget.Nebula.Card.Plain"
    android:id="@+id/option_card"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:clickable="true"
    android:focusable="true"
    app:cardCornerRadius="0dp">

    <LinearLayout
        android:id="@+id/option_layout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="center_vertical"
        android:background="@drawable/bg_nebula_divider_bottom"
        android:gravity="center_vertical"
        android:minHeight="64dp"
        android:orientation="horizontal"
        android:paddingHorizontal="14dp"
        android:paddingVertical="12dp">

        <FrameLayout
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:background="@drawable/bg_nebula_icon_square">

            <ImageView
                android:id="@+id/option_icon"
                android:layout_width="19dp"
                android:layout_height="19dp"
                android:layout_gravity="center"
                android:importantForAccessibility="no"
                app:tint="?attr/colorPrimary" />

        </FrameLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="14dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <com.google.android.material.textview.MaterialTextView
                style="@style/TextAppearance.Nebula.TitleMedium"
                android:id="@+id/option_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textAlignment="viewStart"
                android:textColor="?attr/colorOnSurface"
                android:textSize="15sp"
                tools:text="@string/about" />

            <com.google.android.material.textview.MaterialTextView
                style="@style/TextAppearance.Nebula.Body"
                android:id="@+id/option_description"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:ellipsize="end"
                android:singleLine="true"
                android:textAlignment="viewStart"
                android:textColor="?attr/colorOnSurfaceVariant"
                android:textSize="12.5sp"
                tools:text="@string/about_description" />

            <com.google.android.material.textview.MaterialTextView
                style="@style/TextAppearance.Nebula.LabelMedium"
                android:id="@+id/option_detail"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:ellipsize="none"
                android:marqueeRepeatLimit="marquee_forever"
                android:requiresFadingEdge="horizontal"
                android:singleLine="true"
                android:textAlignment="viewStart"
                android:textColor="?attr/colorPrimary"
                android:visibility="gone"
                tools:text="/tree/primary:Games"
                tools:visibility="visible" />

        </LinearLayout>

        <ImageView
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:layout_marginStart="8dp"
            android:importantForAccessibility="no"
            android:src="@drawable/ic_nebula_chevron"
            app:tint="?attr/colorOnSurfaceVariant" />

    </LinearLayout>

</com.google.android.material.card.MaterialCardView>
