        <item name="materialSwitchStyle">@style/Widget.Citra.Switch</item>
        <item name="sliderStyle">@style/CitraSlider</item>
        <item name="checkboxStyle">@style/Widget.Citra.CheckBox</item>
        <item name="radioButtonStyle">@style/Widget.Citra.RadioButton</item>
        <item name="textInputStyle">@style/Widget.Citra.TextInputLayout</item>
        <item name="chipStyle">@style/Widget.Citra.Chip</item>
        <item name="linearProgressIndicatorStyle">@style/Widget.Citra.LinearProgress</item>
        <item name="circularProgressIndicatorStyle">@style/Widget.Citra.CircularProgress</item>
        <item name="floatingActionButtonStyle">@style/Widget.Citra.FloatingActionButton</item>
        <item name="extendedFloatingActionButtonStyle">@style/Widget.Citra.ExtendedFloatingActionButton</item>
        <item name="materialDividerStyle">@style/Widget.Citra.Divider</item>
        <item name="popupMenuStyle">@style/Widget.Citra.PopupMenu</item>
        <item name="bottomSheetDragHandleStyle">@style/Widget.Citra.BottomSheet.DragHandle</item>
        <item name="materialAlertDialogTheme">@style/ThemeOverlay.Citra.MaterialAlertDialog</item>
        <item name="bottomSheetDialogTheme">@style/ThemeOverlay.Citra.BottomSheetDialog</item>
    </style>

