    <!-- Twin Screen base theme. Neutral colors live here; each color theme below only sets
         its accent family, so all 9 themes (and Material You) share one look. -->
    <style name="Theme.Citra" parent="Theme.Material3.DayNight.NoActionBar">
        <!-- Neutrals -->
        <item name="android:colorBackground">@color/citra_ts_shell</item>
        <item name="colorOnBackground">@color/citra_ts_ink</item>
        <item name="colorSurface">@color/citra_ts_shell</item>
        <item name="colorOnSurface">@color/citra_ts_ink</item>
        <item name="colorSurfaceVariant">@color/citra_ts_panel_alt</item>
        <item name="colorOnSurfaceVariant">@color/citra_ts_ink_muted</item>
        <item name="colorOutline">@color/citra_ts_stroke</item>
        <item name="colorSurfaceInverse">@color/citra_ts_ink</item>
        <item name="colorOnSurfaceInverse">@color/citra_ts_panel</item>
        <item name="colorControlNormal">@color/citra_ts_ink</item>
        <item name="elevationOverlayEnabled">false</item>

        <!-- Twin Screen theme colors -->
        <item name="citraPanelColor">@color/citra_ts_panel</item>
        <item name="citraPanelAltColor">@color/citra_ts_panel_alt</item>
        <item name="citraBandColor">@color/citra_ts_band</item>
