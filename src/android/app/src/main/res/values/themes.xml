        <item name="textAppearanceLabelMedium">@style/TextAppearance.Citra.LabelMedium</item>
        <item name="textAppearanceLabelSmall">@style/TextAppearance.Citra.LabelSmall</item>

        <!-- Shapes: small, square-ish corners -->
        <item name="shapeAppearanceCornerExtraSmall">@style/ShapeAppearance.Citra.Corner.ExtraSmall</item>
        <item name="shapeAppearanceCornerSmall">@style/ShapeAppearance.Citra.Corner.Small</item>
        <item name="shapeAppearanceCornerMedium">@style/ShapeAppearance.Citra.Corner.Small</item>
        <item name="shapeAppearanceCornerLarge">@style/ShapeAppearance.Citra.Corner.Medium</item>
