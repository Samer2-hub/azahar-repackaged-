        <item name="materialButtonStyle">@style/Widget.Citra.Button</item>
        <item name="materialButtonOutlinedStyle">@style/Widget.Citra.Button.Outlined</item>
        <item name="borderlessButtonStyle">@style/Widget.Citra.Button.Text</item>
        <item name="materialIconButtonStyle">@style/Widget.Citra.IconButton</item>
        <item name="materialCardViewStyle">@style/Widget.Citra.Card</item>
        <item name="materialCardViewOutlinedStyle">@style/Widget.Citra.Card</item>
        <item name="materialCardViewFilledStyle">@style/Widget.Citra.Card.Filled</item>
