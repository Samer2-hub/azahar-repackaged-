    </style>
    <style name="Widget.Nebula.PopupMenu" parent="Widget.Material3.PopupMenu">
        <item name="android:popupBackground">@drawable/bg_nebula_popup</item>
    </style>

    <!-- ============ Dialogs and sheets ============ -->
    <style name="ThemeOverlay.Nebula.MaterialAlertDialog" parent="ThemeOverlay.Material3.MaterialAlertDialog">
        <item name="alertDialogStyle">@style/MaterialAlertDialog.Nebula</item>
        <item name="buttonBarPositiveButtonStyle">@style/Widget.Nebula.Button.Text.Dialog</item>
        <item name="buttonBarNegativeButtonStyle">@style/Widget.Nebula.Button.Text.Dialog</item>
        <item name="buttonBarNeutralButtonStyle">@style/Widget.Nebula.Button.Text.Dialog</item>
    </style>
    <style name="MaterialAlertDialog.Nebula" parent="MaterialAlertDialog.Material3">
        <item name="shapeAppearance">@style/ShapeAppearance.Nebula.Corner.ExtraLarge</item>
        <item name="backgroundTint">?attr/nebulaSheetColor</item>
    </style>
    <style name="ThemeOverlay.Nebula.BottomSheetDialog" parent="ThemeOverlay.Material3.BottomSheetDialog">
        <item name="bottomSheetStyle">@style/Widget.Nebula.BottomSheet</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
    </style>
    <style name="Widget.Nebula.BottomSheet" parent="Widget.Material3.BottomSheet.Modal">
        <item name="backgroundTint">?attr/nebulaSheetColor</item>
        <item name="shapeAppearance">@style/ShapeAppearance.Nebula.Sheet</item>
    </style>
    <style name="Widget.Nebula.BottomSheet.DragHandle" parent="Widget.Material3.BottomSheet.DragHandle">
        <item name="tint">?attr/colorOnSurfaceVariant</item>
    </style>

</resources>
