    </style>
    <style name="Widget.Nebula.Card.Elevated" parent="Widget.Material3.CardView.Elevated">
        <item name="cardBackgroundColor">?attr/nebulaGlassColor</item>
        <item name="strokeColor">?attr/nebulaGlassStrokeColor</item>
