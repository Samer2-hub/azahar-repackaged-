    <!-- ============ Navigation ============ -->
    <!-- Floating glass pill at the bottom of the screen -->
    <style name="Widget.Nebula.BottomNavigation" parent="Widget.Material3.BottomNavigationView">
        <item name="android:background">@drawable/bg_nebula_nav</item>
        <item name="backgroundTint">@null</item>
        <item name="itemIconTint">@color/nebula_nav_item</item>
        <item name="itemTextColor">@color/nebula_nav_item</item>
        <item name="itemTextAppearanceActive">@style/TextAppearance.Nebula.NavLabel</item>
        <item name="itemTextAppearanceInactive">@style/TextAppearance.Nebula.NavLabel</item>
        <item name="itemActiveIndicatorStyle">@style/Widget.Nebula.NavIndicator</item>
        <item name="itemRippleColor">@android:color/transparent</item>
        <item name="labelVisibilityMode">labeled</item>
        <item name="paddingBottomSystemWindowInsets">false</item>
        <item name="elevation">10dp</item>
    </style>
    <style name="Widget.Nebula.NavIndicator" parent="Widget.Material3.BottomNavigationView.ActiveIndicator">
        <item name="android:color">?attr/nebulaGlassStrongColor</item>
        <item name="android:width">72dp</item>
        <item name="android:height">34dp</item>
        <item name="shapeAppearance">@style/ShapeAppearance.Nebula.Corner.Full</item>
    </style>
    <style name="Widget.Nebula.NavigationRail" parent="Widget.Material3.NavigationRailView">
        <item name="android:background">@drawable/bg_nebula_nav_rail</item>
        <item name="backgroundTint">@null</item>
        <item name="itemIconTint">@color/nebula_nav_item</item>
        <item name="itemTextColor">@color/nebula_nav_item</item>
        <item name="itemTextAppearanceActive">@style/TextAppearance.Nebula.NavLabel</item>
        <item name="itemTextAppearanceInactive">@style/TextAppearance.Nebula.NavLabel</item>
        <item name="itemActiveIndicatorStyle">@style/Widget.Nebula.NavRailIndicator</item>
        <item name="labelVisibilityMode">labeled</item>
        <item name="paddingTopSystemWindowInsets">false</item>
        <item name="paddingBottomSystemWindowInsets">false</item>
        <item name="elevation">10dp</item>
    </style>
    <style name="Widget.Nebula.NavRailIndicator" parent="Widget.Material3.NavigationRailView.ActiveIndicator">
        <item name="android:color">?attr/nebulaGlassStrongColor</item>
        <item name="shapeAppearance">@style/ShapeAppearance.Nebula.Corner.Medium</item>
    </style>
    <style name="Widget.Nebula.NavigationView" parent="Widget.Material3.NavigationView">
        <item name="backgroundTint">?attr/nebulaSheetColor</item>
        <item name="drawerLayoutCornerSize">28dp</item>
        <item name="itemShapeAppearance">@style/ShapeAppearance.Nebula.Corner.Full</item>
        <item name="itemShapeFillColor">@color/nebula_drawer_item_fill</item>
        <item name="itemIconTint">?attr/colorOnSurface</item>
        <item name="itemTextColor">?attr/colorOnSurface</item>
        <item name="itemTextAppearance">@style/TextAppearance.Nebula.TitleMedium</item>
    </style>
    <style name="Widget.Nebula.Toolbar" parent="Widget.Material3.Toolbar">
        <item name="titleTextAppearance">@style/TextAppearance.Nebula.TitleLarge</item>
    </style>
    <style name="Widget.Nebula.CollapsingToolbar.Medium" parent="Widget.Material3.CollapsingToolbar.Medium">
        <item name="expandedTitleTextAppearance">@style/TextAppearance.Nebula.HeadlineMedium</item>
        <item name="collapsedTitleTextAppearance">@style/TextAppearance.Nebula.TitleLarge</item>
    </style>

    <!-- ============ Controls ============ -->
    <style name="Widget.Nebula.Switch" parent="Widget.Material3.CompoundButton.MaterialSwitch">
        <item name="trackTint">@color/nebula_switch_track</item>
        <item name="thumbTint">@color/nebula_switch_thumb</item>
        <item name="trackDecorationTint">@color/nebula_switch_track_decoration</item>
    </style>
    <style name="CitraSlider" parent="Widget.Material3.Slider">
        <item name="tickVisible">false</item>
        <item name="labelBehavior">gone</item>
        <item name="thumbColor">?attr/colorOnSurface</item>
        <item name="trackColorActive">?attr/colorPrimary</item>
        <item name="trackColorInactive">?attr/nebulaTrackColor</item>
        <item name="trackHeight">6dp</item>
    </style>
    <style name="Widget.Nebula.CheckBox" parent="Widget.Material3.CompoundButton.CheckBox">
        <item name="buttonTint">@color/nebula_check_tint</item>
    </style>
    <style name="Widget.Nebula.RadioButton" parent="Widget.Material3.CompoundButton.RadioButton">
        <item name="buttonTint">@color/nebula_check_tint</item>
    </style>
    <style name="Widget.Nebula.TextInputLayout" parent="Widget.Material3.TextInputLayout.OutlinedBox">
        <item name="boxStrokeColor">@color/nebula_input_stroke</item>
        <item name="boxStrokeWidth">1dp</item>
        <item name="boxStrokeWidthFocused">2dp</item>
        <item name="boxCornerRadiusTopStart">14dp</item>
        <item name="boxCornerRadiusTopEnd">14dp</item>
        <item name="boxCornerRadiusBottomStart">14dp</item>
        <item name="boxCornerRadiusBottomEnd">14dp</item>
    </style>
    <style name="Widget.Nebula.TextInputLayout.Dropdown" parent="Widget.Material3.TextInputLayout.OutlinedBox.ExposedDropdownMenu">
        <item name="boxStrokeColor">@color/nebula_input_stroke</item>
        <item name="boxStrokeWidth">1dp</item>
        <item name="boxStrokeWidthFocused">2dp</item>
        <item name="boxCornerRadiusTopStart">14dp</item>
        <item name="boxCornerRadiusTopEnd">14dp</item>
        <item name="boxCornerRadiusBottomStart">14dp</item>
        <item name="boxCornerRadiusBottomEnd">14dp</item>
    </style>
    <!-- Glass pill chip; selected chips turn solid white -->
    <style name="Widget.Nebula.Chip" parent="Widget.Material3.Chip.Suggestion">
        <item name="chipBackgroundColor">@color/nebula_chip_bg</item>
        <item name="chipStrokeColor">?attr/nebulaGlassStrokeColor</item>
        <item name="chipStrokeWidth">1dp</item>
        <item name="chipCornerRadius">18dp</item>
        <item name="chipMinHeight">36dp</item>
        <item name="android:textColor">@color/nebula_chip_text</item>
        <item name="android:textAppearance">@style/TextAppearance.Nebula.Chip</item>
        <item name="checkedIconTint">?attr/colorSurface</item>
        <item name="chipIconTint">@color/nebula_chip_text</item>
        <item name="elevation">0dp</item>
    </style>
    <style name="Widget.Nebula.LinearProgress" parent="Widget.Material3.LinearProgressIndicator">
        <item name="trackThickness">6dp</item>
        <item name="trackCornerRadius">3dp</item>
        <item name="indicatorColor">?attr/colorPrimary</item>
        <item name="trackColor">?attr/nebulaTrackColor</item>
    </style>
    <style name="Widget.Nebula.CircularProgress" parent="Widget.Material3.CircularProgressIndicator">
        <item name="trackThickness">4dp</item>
        <item name="indicatorColor">?attr/colorPrimary</item>
    </style>
    <style name="Widget.Nebula.FloatingActionButton" parent="Widget.Material3.FloatingActionButton.Primary">
        <item name="shapeAppearanceOverlay">@style/ShapeAppearance.Nebula.Corner.Large</item>
        <item name="backgroundTint">?attr/colorOnSurface</item>
        <item name="tint">?attr/colorSurface</item>
    </style>
    <style name="Widget.Nebula.ExtendedFloatingActionButton" parent="Widget.Material3.ExtendedFloatingActionButton.Icon.Primary">
        <item name="shapeAppearanceOverlay">@style/ShapeAppearance.Nebula.Corner.Full</item>
        <item name="backgroundTint">?attr/colorOnSurface</item>
        <item name="android:textColor">?attr/colorSurface</item>
        <item name="iconTint">?attr/colorSurface</item>
        <item name="android:textAppearance">?attr/textAppearanceLabelLarge</item>
    </style>
    <style name="Widget.Nebula.Divider" parent="Widget.Material3.MaterialDivider">
        <item name="dividerColor">@color/nebula_glass_line</item>
