    </style>
    <style name="Widget.Nebula.Card.Filled" parent="Widget.Material3.CardView.Filled">
        <item name="cardBackgroundColor">?attr/nebulaGlassColor</item>
        <item name="strokeColor">?attr/nebulaGlassStrokeColor</item>
        <item name="strokeWidth">1dp</item>
        <item name="cardCornerRadius">18dp</item>
